{
  "id": "onlineradiobox",
  "name": "Online Radio Box",
  "version": "0.1.0",
  "apiVersion": 13,
  "entry": "plugin.js",
  "icon": "icon.png",
  "description": "Radio en vivo de Online Radio Box: miles de emisoras por país y género, con búsqueda.",
  "author": "xuper-plugin",
  "homepage": "https://github.com/xuper-plugin/kino-plugin-onlineradiobox",
  "hosts": [
    "onlineradiobox.com",
    "*.onlineradiobox.com"
  ],
  "capabilities": [
    "search",
    "home",
    "browse",
    "resolve",
    "channels"
  ],
  "liveStreamHosts": "any",
  "color": "#14B8A6",
  "theme": {
    "accent": "#14B8A6",
    "onAccent": "#03201C",
    "background": "#0B1213",
    "surface": "#16221F",
    "highlight": "#F4B860"
  },
  "settings": [
    {
      "key": "country",
      "type": "select",
      "label": "País de las emisoras",
      "labelEn": "Stations' country",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Automático (según tu idioma)",
          "labelEn": "Automatic (from your language)"
        },
